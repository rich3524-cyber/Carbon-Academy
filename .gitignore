# Dependencies
node_modules/

# Next.js
.next/
out/

# Builds
dist/
build/

# Environment (only .env.example is committed)
.env
.env.*
!.env.example

# Supabase local
supabase/.branches/
supabase/.temp/

# Netlify
.netlify/

# Testing
coverage/

# Logs
*.log
npm-debug.log*

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Brand guidelines PDF is internal and partner use only. Keep a local copy
# in docs/brand/ from the Carbon asset library; docs/BRAND.md is the committed extract
docs/brand/*.pdf

# Unlicensed font files must never be committed (see docs/BRAND.md)
*.otf
*.ttf
# Except Arimo, which is SIL OFL 1.1 and licensed for embedding and redistribution
# (BRAND.md "Certificate PDF"). tests/brand/fonts.test.ts allows nothing else here.
!src/lib/certificates/fonts/Arimo-Regular.ttf
!src/lib/certificates/fonts/Arimo-Bold.ttf

# TypeScript and Next.js generated
*.tsbuildinfo
next-env.d.ts

# Keys and certificates
*.pem
